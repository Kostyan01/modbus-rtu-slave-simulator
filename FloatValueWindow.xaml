<Window x:Class="ModbusRtuSimulator.FloatValueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Значение Float32" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock Text="Значение (IEEE-754 Float32)" Margin="3" />
        <TextBox x:Name="ValueBox" Width="240" Margin="3" />
        <TextBlock Text="Порядок байтов и слов в двух регистрах" Margin="3,10,3,3" />
        <ComboBox x:Name="WordOrderCombo" Width="240" Margin="3" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Применить" IsDefault="True" Click="Apply_Click" />
            <Button Content="Отмена" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
